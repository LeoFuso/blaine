     "unified": "--- /dev/null\n+++ b/tests/test_human_response_bounds.py\n@@ -0,0 +1,54 @@\n+import pytest\n+from runtime.kernel.human import validate_response, request_digest\n+\n+\n+def _accepted_request():\n+    return {\n+        'task_id': 'task-abc',\n+        'origin_task_id': 'task-abc',\n+        'request_id': 'req-001',\n+        'revision': 2,\n+        'question': 'Approve?',\n+        'allowed_responses': ['yes', 'no'],\n+    }\n+\n+\n+def _valid_response(accepted):\n+    return {\n+        'task_id': 'task-abc',\n+        'request_id': 'req-001',\n+        'request_revision': 2,\n+        'request_digest': request_digest(accepted),\n+        'response_id': 'resp-001',\n+        'value': 'yes',\n+    }\n+\n+\n+def test_value_outside_allowed_raises():\n+    accepted = _accepted_request()\n+    response = _valid_response(accepted)\n+    response['value'] = 'maybe'\n+    with pytest.raises(ValueError):\n+        validate_response(response, accepted, 'task-abc')\n+\n+\n+def test_stale_revision_raises():\n+    accepted = _accepted_request()\n+    response = _valid_response(accepted)\n+    response['request_revision'] = 1\n+    with pytest.raises(ValueError):\n+        validate_response(response, accepted, 'task-abc')\n+\n+\n+def test_wrong_digest_raises():\n+    accepted = _accepted_request()\n+    response = _valid_response(accepted)\n+    response['request_digest'] = '0' * 64\n+    with pytest.raises(ValueError):\n+        validate_response(response, accepted, 'task-abc')\n+\n+\n+def test_valid_response_ok():\n+    accepted = _accepted_request()\n+    response = _valid_response(accepted)\n+    assert validate_response(response, accepted, 'task-abc') == response\n",
