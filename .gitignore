# .gitignore for blaine repository
# Excludes machine-specific configuration, secrets, and private data

# Environment and credentials (NEVER commit secrets)
.env
.env.*
*.env
.env.local
*.key
*.pem
secrets/

# Local configuration directories
.local/
.gitconfig.local

# Machine-specific paths and configs
machine-config/
~/.goose/local-*

# IDE and editor state
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Build artifacts (if any)
target/
build/
dist/

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp

# Backup files
*.bak
*.backup

# OS-specific
Thumbs.db
Desktop.ini

# Goose session state (machine-local)
goose-sessions/
session-*.json

# Docker volumes or bind mounts (if used for testing)
docker-volumes/

# Any local skill overrides (allow portable skills, ignore machine-specific variants)
skills/local-override/

# Generated test data
test-data/generated/

# Compiled code (if any)
*.class
*.o
*.pyc
__pycache__/
