[Unit]
Description=Blaine local Qwen generation
# vLLM profiles global free VRAM: embedding startup must finish before profiling.
Wants=blaine-embedding.service
After=blaine-embedding.service
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=exec
ExecStartPre=/usr/bin/python3 %h/.config/blaine/services/wait-ready.py --timeout 120 http://127.0.0.1:8001/health
ExecStart=/usr/bin/python3 %h/.config/blaine/inference/serve.py %h/.config/blaine/inference/candidate.json generation
ExecStartPost=/usr/bin/python3 %h/.config/blaine/services/wait-ready.py --unit blaine-generation.service --timeout 1500 http://127.0.0.1:8000/health
Restart=on-failure
RestartSec=15
TimeoutStartSec=1650
TimeoutStopSec=45
MemoryHigh=22G
MemoryMax=28G
MemorySwapMax=0
CPUQuota=800%
CPUWeight=50
Nice=5
OOMPolicy=stop
UMask=0077

[Install]
WantedBy=default.target
