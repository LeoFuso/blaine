{
  "version": 1,
  "source": {
    "provider": "bitwarden-secrets-manager",
    "project": "blaine-dev",
    "project_id": "ac68b692-2150-45da-ab69-b4ca0085935a",
    "bootstrap": {
      "store": "gnome-keyring",
      "service": "leofuso-lab",
      "credential": "bws-access-token"
    },
    "access": "materialization and rotation only; never runtime"
  },
  "destination_root": "~/.config/blaine/secrets",
  "consumers": {
    "jev": {
      "description": "Isolated TypeSafe/Jev provider candidate; bounded worker process, no service.",
      "destination": "jev.env",
      "mode": "0600",
      "service": null,
      "secrets": [
        {
          "key": "TYPESAFE_API_KEY",
          "source_key": "TYPESAFE_API_KEY",
          "source_id": null,
          "minimum_length": 20
        }
      ]
    },
    "grafana-metrics": {
      "description": "Compatibility check against the already-proven Grafana metrics materialization.",
      "destination": "grafana-metrics.env",
      "mode": "0600",
      "service": null,
      "secrets": [
        {
          "key": "GRAFANA_CLOUD_METRICS_API_KEY",
          "source_key": "GRAFANA_CLOUD_METRICS_API_KEY",
          "source_id": null,
          "minimum_length": 20
        }
      ]
    }
  }
}
